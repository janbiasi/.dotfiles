{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.envrc)", "Bash(op *)"]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.config/herdr/report-project.sh\" --claude-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": ["com.apple.coresimulator.*"]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/go-build",
        "~/.cache/golangci-lint",
        "~/.cache/prek",
        "~/go/pkg/mod"
      ],
      "denyRead": [
        "~/.ssh/config.d",
        "~/.gnupg",
        "~/.password-store",
        "~/.git-credentials",
        "~/.kube",
        "~/.aws",
        "~/.1password",
        "~/.config/1Password",
        "~/.config/op",
        "~/.op"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        }
      ],
      "allowPlaintextInject": false
    },
    "excludedCommands": [
      "podman *",
      "docker *",
      "chromium",
      "herdr",
      "devenv *",
      "prek *",
      "git commit *",
      "git cherry-pick *",
      "git push *",
      "git fetch *"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "theme": "auto",
  "agentPushNotifEnabled": true
}
