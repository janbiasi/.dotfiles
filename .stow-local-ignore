# Files to be ignored by gnu 'stow'

# Comments and blank lines are allowed.

# See 'info stow' section "4 Ignore Lists" for more information

RCS
.+,v
.DS_Store

CVS
\.\#.+ # CVS conflict files / emacs lock files
\.cvsignore

\.svn
\_darcs
\.hg
\.macos
# \.gitignore
\.git
\.gitmodules

.+~ # emacs backup files
\#.\*\# # emacs autosave files

^/README.md
^/LICENSE.md
^/COPYING
^/.editorconfig
^/.gitconfig

/extra # additional installation files not needed to copy
^/etc # system configuration installed separately with make install-etc
/Makefile # utility tool
/docs # only for documentation purposes
\*.rayconfig # raycast config backup files

\*.tpl # template files
\.target\.wants # systemd enablement artifacts (created by systemctl enable, machine state not config)
node_modules # workspace dependencies (pnpm install)
^/package.json # pnpm workspace root
^/pnpm-workspace.yaml
^/pnpm-lock.yaml
^/.config/pi/extensions # loaded from the repo via .config/pi/settings.json, never symlinked
