{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "instructions": ["CONTRIBUTING.md", ".cursor/rules/*.md"],
  "plugins": [
    // "opencode-beads@latest",
    "cc-safety-net@latest",
  ],
  "default_agent": "build",
  "experimental": {
    "policies": [
      { "action": "permission", "resource": "shell:sudo *", "effect": "deny" },
      {
        "action": "permission",
        "resource": "shell:sudoedit *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:pacman *",
        "effect": "deny",
      },
      { "action": "permission", "resource": "shell:yay *", "effect": "deny" },
      { "action": "permission", "resource": "shell:paru *", "effect": "deny" },
      {
        "action": "permission",
        "resource": "shell:pkexec *",
        "effect": "deny",
      },
      { "action": "permission", "resource": "shell:run0 *", "effect": "deny" },
      { "action": "permission", "resource": "shell:doas *", "effect": "deny" },
      { "action": "permission", "resource": "shell:su *", "effect": "deny" },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/sudo *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/sudoedit *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/pacman *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/yay *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/paru *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/pkexec *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/run0 *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/doas *",
        "effect": "deny",
      },
      {
        "action": "permission",
        "resource": "shell:/usr/bin/su *",
        "effect": "deny",
      },
    ],
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "~/.config/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow",
    },
    // Read, skill and todos are always allowed
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "todoread", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    // Shell execution permission (non-tools)
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    // git
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    // node
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "yarn *", "effect": "allow" },
    { "action": "shell", "resource": "bun *", "effect": "allow" },
    // nix
    { "action": "shell", "resource": "devbox *", "effect": "allow" },
    { "action": "shell", "resource": "devenv *", "effect": "allow" },
    // golang
    { "action": "shell", "resource": "go *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint *", "effect": "allow" },
    // beads
    { "action": "shell", "resource": "bd *", "effect": "allow" },
    // general read permissions
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.envrc*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    // MCP server permissions
    { "action": "context7_*", "resource": "*", "effect": "allow" },
    { "action": "serena_*", "resource": "*", "effect": "allow" },
    // Tool integrations
    { "action": "Beads-Task-Agent*", "resource": "*", "effect": "allow" },
    { "action": "codegraph*", "resource": "*", "effect": "allow" },
    // Important deny rules
    { "action": "rm", "resource": "*", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "plane": {
        "type": "remote",
        "disabled": true,
        "url": "https://mcp.plane.so/http/mcp",
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}",
        },
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
        "disabled": false,
      },
      "chrome": {
        "type": "local",
        "disabled": false,
        "command": ["npx", "chrome-devtools-mcp@latest"],
      },
      "posthog": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp-eu.posthog.com/mcp",
      },
      "treepolicy": {
        "disabled": true,
        "type": "local",
        "command": ["treepolicy-mcp"],
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": true,
      },
      "kaneo": {
        "type": "remote",
        "url": "https://kaneo.biasi.info/api/mcp",
        "disabled": true,
      },
    },
  },
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "gemma4": {},
      },
    },
  },
}
