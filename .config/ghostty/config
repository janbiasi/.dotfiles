# basic ui configuration
theme = light:Matugen Light,dark:Matugen Dark
cursor-style = block
cursor-opacity = 0.9
font-family = "JetBrainsMono Nerd Font"
font-codepoint-map = U+2714=Noto Sans Symbols 2
font-size = 10
window-padding-color = background
window-padding-x = 10,10
window-padding-y = 10,10

# keybindings
keybind = alt+left=esc:B
keybind = alt+right=esc:F
keybind = ctrl+enter=unbind

# macos specific configuration
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-window-shadow = false
mouse-hide-while-typing = true
background-blur-radius = 70
background-opacity = 1

# Set the title to empty, since it only shows "t" when in
# a tmux session and not what is actually going on
title = " "
