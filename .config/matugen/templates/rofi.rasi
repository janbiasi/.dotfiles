/* Generated by Matugen. */
* {
    surface-container:      {{colors.surface_container.default.hex}};
    surface-container-high: {{colors.surface_container_high.default.hex}};
    text:                   {{colors.on_surface.default.hex}};
    muted:                  {{colors.on_surface_variant.default.hex}};
    outline-variant:        {{colors.outline_variant.default.hex}};
    primary:                {{colors.primary.default.hex}};
    on-primary:             {{colors.on_primary.default.hex}};
    primary-container:      {{colors.primary_container.default.hex}};
    on-primary-container:   {{colors.on_primary_container.default.hex}};

    background-color: transparent;
    text-color:       @text;
    font:             "JetBrains Mono 10";
}

window {
    location:         center;
    anchor:           center;
    width:            560px;
    background-color: transparent;
    enabled:          true;
}

mainbox {
    enabled:          true;
    spacing:          4px;
    padding:          8px;
    background-color: @surface-container;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    16px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    enabled:          true;
    padding:          9px 14px;
    background-color: @surface-container-high;
    border:           0px;
    border-radius:    10px;
    children:         [ "prompt", "entry" ];
}

prompt {
    enabled:          true;
    text-color:       @primary;
    font:             "JetBrains NerdFont Mono 10";
}

entry {
    enabled:          true;
    placeholder:      "Execute command...";
    placeholder-color: @muted;
    font:              "JetBrains Mono 10";
}

listview {
    enabled:          true;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;

    fixed-height:     false;
    spacing:          2px;

    margin:           0px;
    padding:          4px 2px;
    background-color: transparent;
    border:           0px;
}

element {
    enabled:          true;
    spacing:          12px;
    padding:          7px 10px;
    cursor:           pointer;
    border:           0px;
    border-color:     transparent;
    border-radius:    10px;
}

element selected.normal {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element-icon {
    size:             22px;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    cursor:           inherit;
    text-color:       inherit;
}
