{
  "id": "matugen",
  "name": "Matugen",
  "author": "Matugen",
  "version": "1.0.0",
  "isPreset": false,
  "isReadOnly": true,
  "colors": {
    "bg": {
      "base": "{{colors.surface.default.hex}}",
      "elevated": "{{colors.surface_container_low.default.hex}}",
      "overlay": "{{colors.surface_container_high.default.hex}}",
      "input": "{{colors.surface_container.default.hex}}",
      "tooltip": "{{colors.surface_container_highest.default.hex}}"
    },
    "surface": {
      "primary": "{{colors.surface_container.default.hex}}",
      "secondary": "{{colors.surface_container_high.default.hex}}",
      "tertiary": "{{colors.surface_container_highest.default.hex}}",
      "hover": "{{colors.surface_container_high.default.hex}}",
      "active": "{{colors.primary_container.default.hex}}",
      "disabled": "{{colors.surface_variant.default.hex}}"
    },
    "text": {
      "primary": "{{colors.on_surface.default.hex}}",
      "secondary": "{{colors.on_surface_variant.default.hex}}",
      "muted": "{{colors.on_surface_variant.default.hex}}",
      "disabled": "{{colors.outline.default.hex}}",
      "accent": "{{colors.primary.default.hex}}",
      "inverse": "{{colors.on_primary.default.hex}}"
    },
    "accent": {
      "primary": "{{colors.primary.default.hex}}",
      "secondary": "{{colors.secondary.default.hex}}",
      "success": "{{colors.success.default.hex}}",
      "warning": "{{colors.tertiary.default.hex}}",
      "error": "{{colors.error.default.hex}}",
      "info": "{{colors.primary.default.hex}}"
    },
    "border": {
      "subtle": "{{colors.outline_variant.default.hex}}",
      "default": "{{colors.outline_variant.default.hex}}",
      "strong": "{{colors.outline.default.hex}}",
      "focus": "{{colors.primary.default.hex}}"
    },
    "semantic": {
      "string": "{{colors.success.default.hex}}",
      "number": "{{colors.tertiary.default.hex}}",
      "boolean": "{{colors.syntax_keyword.default.hex}}",
      "date": "{{colors.secondary.default.hex}}",
      "null": "{{colors.outline.default.hex}}",
      "primaryKey": "{{colors.tertiary.default.hex}}",
      "foreignKey": "{{colors.primary.default.hex}}",
      "index": "{{colors.syntax_type.default.hex}}",
      "connectionActive": "{{colors.success.default.hex}}",
      "connectionInactive": "{{colors.outline.default.hex}}",
      "modified": "{{colors.tertiary.default.hex}}",
      "deleted": "{{colors.error.default.hex}}",
      "new": "{{colors.success.default.hex}}"
    }
  },
  "typography": {
    "fontFamily": {
      "base": "Inter, system-ui, Avenir, Helvetica, Arial, sans-serif",
      "mono": "JetBrains Mono, Fira Code, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem"
    }
  },
  "layout": {
    "borderRadius": {
      "sm": "0.25rem",
      "base": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem"
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "base": "1rem",
      "lg": "1.5rem",
      "xl": "2rem"
    }
  },
  "monacoTheme": {
    "base": "<* if {{is_dark_mode}} *>vs-dark<* else *>vs<* endif *>",
    "inherit": true,
    "rules": [
      {
        "token": "keyword",
        "foreground": "{{colors.syntax_keyword.default.hex_stripped}}"
      },
      {
        "token": "string",
        "foreground": "{{colors.success.default.hex_stripped}}"
      },
      {
        "token": "number",
        "foreground": "{{colors.tertiary.default.hex_stripped}}"
      },
      {
        "token": "comment",
        "foreground": "{{colors.on_surface_variant.default.hex_stripped}}"
      },
      {
        "token": "type",
        "foreground": "{{colors.syntax_type.default.hex_stripped}}"
      },
      {
        "token": "operator",
        "foreground": "{{colors.on_surface_variant.default.hex_stripped}}"
      }
    ],
    "colors": {
      "editor.background": "{{colors.surface.default.hex}}",
      "editor.foreground": "{{colors.on_surface.default.hex}}",
      "editorLineNumber.foreground": "{{colors.outline.default.hex}}",
      "editorLineNumber.activeForeground": "{{colors.primary.default.hex}}",
      "editorCursor.foreground": "{{colors.primary.default.hex}}",
      "editor.selectionBackground": "{{colors.primary_container.default.hex}}",
      "editor.lineHighlightBackground": "{{colors.surface_container.default.hex}}",
      "editorWidget.background": "{{colors.surface_container_high.default.hex}}",
      "editorWidget.border": "{{colors.outline_variant.default.hex}}"
    }
  }
}
