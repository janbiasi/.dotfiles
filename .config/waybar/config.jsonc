{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,
  "fixed-center": true,
  "reload_style_on_change": true,
  "include": [
    "./modules/distro.jsonc",
    "./modules/workspace.jsonc",
    "./modules/wallpaper.jsonc",
    "./modules/system.jsonc",
    "./modules/clock.jsonc",
    "./modules/audio.jsonc",
    "./modules/connections.jsonc",
    "./modules/battery.jsonc",
    "./modules/power.jsonc",
    "./modules/voxtype.jsonc",
    "./modules/screen-share.jsonc",
    "./modules/tray-notif.jsonc",
    "./modules/ai.jsonc",
  ],
  "modules-left": [
    "custom/distro",
    "hyprland/workspaces",
    "group/system",
    "custom/wallpaper",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/ai-all",
    "custom/voxtype",
    "custom/screen-share",
    "pulseaudio",
    "network",
    "custom/vpn",
    "bluetooth",
    "battery",
    "idle_inhibitor",
    "custom/power",
    "custom/notifications",
  ],
}
