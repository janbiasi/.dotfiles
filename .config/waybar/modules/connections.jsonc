{
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀 Ethernet",
    "format-linked": "󰈀 No IP",
    "format-disconnected": "󰤭 Offline",
    "format-disabled": "󰤮 Off",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "max-length": 22,
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}% · {frequency} GHz\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "No network connection\nClick to manage Wi-Fi",
    "on-update": "$HOME/.config/rofi/scripts/wifi --cache",
    "on-click": "$HOME/.config/hypr/scripts/rofi-toggle Wi-Fi"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Bluetooth: {status}\nClick to manage devices",
    "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
    "on-click": "$HOME/.config/hypr/scripts/rofi-toggle Bluetooth"
  },
  "custom/vpn": {
    "exec": "$HOME/.config/waybar/scripts/vpn.sh",
    "return-type": "json",
    "interval": 10,
    "format": "{icon}",
    "format-icons": {
      "connected": "󰦝",
      "disconnected": "󰦞",
      "error": "󱦚"
    },
    "on-click": "$HOME/.config/hypr/scripts/rofi-toggle VPN"
  }
}
