{
  "hyprland/workspaces": {
    "format": "<span size='9pt' weight='bold'>{icon}</span> {windows}",
    "format-icons": {
      "scratchpad": "✦",
      "special:scratchpad": "✦",
    },
    "on-click": "activate",
    "all-outputs": false,
    "show-special": true,
    "special-visible-only": true,
    "window-rewrite-default": "",
    "format-window-separator": " ",
    "window-rewrite": {
      "class<.*[Gg]hostty.*>": "󰊠",
      "class<.*[Ff]irefox.*>": "",
      "class<.*[Bb]rave.*>": "󰖟",
      "class<.*[Cc]hrom.*>": "",
      "class<.*[Zz]ed.*>": "󰬡",
      "class<.*vscode.*>": "󰨞",
      "class<.*t3code.*>": "󰚩",
      "class<.*[Pp]aseo.*>": "󰚩",
      "class<.*[Cc]hatgpt.*>": "",
      "class<.*([Cc]itrix|[Ss]elfservice|[Ww]fica).*>": "󰢹",
      "class<.*[Oo]bsidian.*>": "",
      "class<.*[Dd]iscord.*>": "",
      "title<.*[Tt]eams.*>": "󰊻",
      "class<.*[Ss]potify.*>": "",
      "class<.*[Tt]hunar.*>": "",
      "class<.*[Dd]olphin.*>": "",
      "class<.*[Ss]team.*>": "",
      "class<.*whatsapp.*>": "",
      "class<libreoffice-writer>": "",
      "class<libreoffice-calc>": "",
      "class<libreoffice-impress>": "",
      "class<libreoffice-draw>": "",
      "class<libreoffice-base>": "",
      "class<libreoffice-math>": "",
      "class<libreoffice-startcenter>": "",
    },
  },
}
