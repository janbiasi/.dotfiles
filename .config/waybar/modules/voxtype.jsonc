{
  "custom/voxtype": {
    "exec": "voxtype status --follow --format json",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "󰍬",
      "recording": "󰓆",
      "transcribing": "󰔟",
      "stopped": "󰍭"
    },
    "tooltip": true,
    "on-click": "voxtype record toggle"
  }
}
