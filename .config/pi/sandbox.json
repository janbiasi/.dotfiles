{
  "enabled": true,
  "network": {
    "allowedDomains": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "files.pythonhosted.org",
      "api.nuget.org",
      "github.com",
      "*.github.com",
      "codeload.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com"
    ],
    "deniedDomains": [],
    "allowLocalBinding": true
  },
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.gnupg",
      "~/.password-store",
      "~/.aws",
      "~/.kube",
      "~/.docker/config.json",
      "~/.config/gh",
      "~/.git-credentials",
      "~/.config/pi/auth.json",
      "~/.config/pi/models-store.json",
      "~/.local/share/keyrings"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.npm",
      "~/.cache",
      "~/.bun/install/cache",
      "~/.local/share/pnpm",
      "~/.nuget/packages"
    ],
    "denyWrite": ["**/.env", "**/.env.*", "**/.envrc", ".pi"]
  },
  "denyEnv": ["SSH_AUTH_SOCK", "GPG_AGENT_INFO", "*_TOKEN", "*_API_KEY", "*_SECRET", "*_PASSWORD"]
}
